<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>New Frontier</title>
  <link rel="stylesheet" href="/css/dashboard.css"/>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg"/>
</head>
<body class="dashboard-body">

  <%- include('dashboard/_nav', { currentPage, applicant }) %>

  <main class="dash-main">
    <%- include(page, { ...locals }) %>
  </main>

  <% if (typeof message !== 'undefined' && message) { %>
  <div class="dash-flash" role="alert">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6" stroke="#3DAA6C" stroke-width="1.5"/>
      <path d="M5 8l2 2 4-4" stroke="#3DAA6C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <%= message %>
  </div>
  <% } %>

</body>
</html>
