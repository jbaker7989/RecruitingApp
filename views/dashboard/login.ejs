<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign In — New Frontier</title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg"/>
  <link rel="stylesheet" href="/css/tokens.css"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text-2);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Login wrapper ── */
    .login-wrap {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 420px;
      min-height: 100vh;
    }

    @media (max-width: 768px) {
      .login-wrap { grid-template-columns: 1fr; }
      .login-graphic-col { display: none; }
    }

    /* ── Illustration column ── */
    .login-graphic-col {
      background: linear-gradient(155deg, var(--bg) 0%, var(--surface) 50%, var(--elevated) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px;
      position: relative;
      overflow: hidden;
    }

    .login-graphic-col::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 70% 80%, rgba(61, 170, 108, 0.08) 0%, transparent 60%),
                  radial-gradient(ellipse at 20% 20%, rgba(74, 58, 107, 0.1) 0%, transparent 50%);
      pointer-events: none;
    }

    .login-graphic-col svg,
    .login-graphic-col img {
      max-width: 100%;
      height: auto;
      max-height: 480px;
      position: relative;
      border-radius: 8px;
    }

    /* ── Form column ── */
    .login-form-col {
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 40px;
    }

    .login-card {
      width: 100%;
      max-width: 360px;
    }

    .login-card__logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 32px;
    }

    .login-card__logo-mark {
      width: 36px;
      height: 36px;
    }

    .login-card__logo-text {
      font-size: 1.1em;
      font-weight: 700;
      color: var(--text-1);
      letter-spacing: 0.2em;
    }

    .login-card__heading {
      font-size: 1.5em;
      font-weight: 700;
      color: var(--text-1);
      margin-bottom: 6px;
    }

    .login-card__sub {
      font-size: 0.875em;
      color: var(--text-3);
      margin-bottom: 32px;
    }

    /* ── Form elements ── */
    .form-field {
      margin-bottom: 18px;
    }

    .form-field label {
      display: block;
      font-size: 0.8em;
      font-weight: 600;
      color: var(--text-3);
      margin-bottom: 7px;
      letter-spacing: 0.03em;
    }

    .form-field input {
      width: 100%;
      padding: 11px 14px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: var(--text-1);
      font-size: 0.9em;
      font-family: inherit;
      transition: border-color 0.2s, background 0.2s;
    }

    .form-field input::placeholder {
      color: rgba(255, 255, 255, 0.2);
    }

    .form-field input:focus {
      outline: none;
      border-color: var(--emerald);
      background: rgba(255, 255, 255, 0.07);
    }

    /* ── Error message ── */
    .form-error {
      background: var(--danger-bg);
      border: 1px solid rgba(201, 64, 64, 0.3);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.85em;
      color: var(--danger);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-error svg {
      flex-shrink: 0;
    }

    /* ── Submit button ── */
    .btn-primary {
      width: 100%;
      padding: 13px;
      background: var(--emerald);
      color: var(--text-1);
      border: none;
      border-radius: 8px;
      font-size: 0.95em;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      letter-spacing: 0.02em;
    }

    .btn-primary:hover { background: var(--emerald-dk); }
    .btn-primary:active { transform: scale(0.99); }

    /* ── Footer links ── */
    .login-footer {
      margin-top: 24px;
      text-align: center;
      font-size: 0.8em;
      color: var(--text-4);
    }

    .login-footer a {
      color: var(--emerald);
      text-decoration: none;
      font-weight: 600;
    }

    .login-footer a:hover { text-decoration: underline; }

    .login-divider {
      height: 1px;
      background: rgba(255,255,255,0.06);
      margin: 24px 0;
    }
  </style>
</head>
<body>

<div class="login-wrap">

  <!-- ── Left: Brand illustration ── -->
  <div class="login-graphic-col">
    <img
      src="/images/frontier-illustration.svg"
      alt="New Frontier — guiding your career journey"
      width="800"
      height="480"
    />
  </div>

  <!-- ── Right: Login form ── -->
  <div class="login-form-col">
    <div class="login-card">

      <!-- Logo -->
      <div class="login-card__logo">
        <svg class="login-card__logo-mark" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="18,3 33,12 33,24 18,33 3,24 3,12" style="stroke:var(--emerald)" stroke-width="2" fill="rgba(61,170,108,0.1)"/>
          <text x="18" y="22" text-anchor="middle" font-size="11" font-weight="800" style="fill:var(--emerald)" font-family="-apple-system, sans-serif" letter-spacing="0.1em">NF</text>
        </svg>
        <span class="login-card__logo-text">NEW FRONTIER</span>
      </div>

      <h1 class="login-card__heading">Welcome back</h1>
      <p class="login-card__sub">Sign in to track your applications and find new opportunities.</p>

      <!-- Error -->
      <% if (error) { %>
      <div class="form-error" role="alert">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6" style="stroke:var(--danger)" stroke-width="1.5"/>
          <path d="M7 4v3.5M7 9.5v.5" style="stroke:var(--danger)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <%= error %>
      </div>
      <% } %>

      <form method="POST" action="/dashboard/login" autocomplete="on">
        <!-- Preserve redirect target -->
        <% if (next) { %>
        <input type="hidden" name="next" value="<%= next %>"/>
        <% } %>

        <div class="form-field">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            value="<%= email %>"
            required
            autofocus
            autocomplete="email"
          />
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="btn-primary">Sign In</button>
      </form>

      <div class="login-divider"></div>

      <div class="oauth-buttons">
        <a href="/api/applicants/auth/google" class="oauth-btn oauth-btn--google" title="Sign in with Google">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>Continue with Google</span>
        </a>
        <a href="/api/applicants/auth/linkedin" class="oauth-btn oauth-btn--linkedin" title="Sign in with LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#0A66C2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>Continue with LinkedIn</span>
        </a>
        <a href="/api/applicants/auth/facebook" class="oauth-btn oauth-btn--facebook" title="Sign in with Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.046V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Continue with Facebook</span>
        </a>
      </div>

      <style>
        .oauth-buttons {
          display: flex;
          flex-direction: column;
          gap: 10px;
          margin-top: 20px;
        }
        .oauth-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          padding: 11px 14px;
          background: rgba(255, 255, 255, 0.05);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 8px;
          color: var(--text-2);
          font-size: 0.9em;
          font-weight: 600;
          font-family: inherit;
          text-decoration: none;
          transition: background 0.2s, border-color 0.2s;
        }
        .oauth-btn:hover {
          background: rgba(255, 255, 255, 0.08);
          border-color: rgba(255, 255, 255, 0.2);
        }
        .oauth-btn:active {
          transform: scale(0.98);
        }
      </style>

      <p class="login-footer">
        New to New Frontier? <a href="/dashboard/register">Create an account</a>
      </p>
    </div>
  </div>

</div>

</body>
</html>
