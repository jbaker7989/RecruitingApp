{
  "name": "rec-app-build",
  "version": "1.0.0",
  "description": "New Fronteir Recruiting Application",
  "main": "dist/index.js",
  "engines": {
    "node": "24"
  },
  "engineStrict": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pi": "pi",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "smoke": "node scripts/ci-smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "vercel-build": "tsc && node scripts/preflight.mjs",
    "db:migrate-json": "node --import tsx scripts/migrate-json-to-db.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.test.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.test.ts\" --fix",
    "telemetry:stack:up": "docker compose -f observability/local/docker-compose.yml up -d",
    "telemetry:stack:down": "docker compose -f observability/local/docker-compose.yml down",
    "telemetry:verify": "node scripts/telemetry-local-verify.mjs",
    "test:observability:p2": "tsx --test \"tests/observability-p2*.test.ts\"",
    "telemetry:p2:fixtures": "node --import tsx scripts/observability-p2-fixtures.mjs",
    "telemetry:p2:verify": "node --import tsx scripts/observability-p2-verify.mjs",
    "telemetry:p2:cost-report": "node --import tsx scripts/observability-p2-cost-report.mjs",
    "test:db": "tsx --test --test-concurrency=1 \"tests/integration/database*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@pinecone-database/pinecone": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "mammoth": "^1.12.3",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/eslint-parser": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/node": "^22.20.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
