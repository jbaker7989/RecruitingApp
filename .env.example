# LLM Provider API Keys (Required for Agentic Workflows)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override default port
PORT=3000

# Optional: Environment (development/production)
NODE_ENV=development

# OAuth 2.0 / OIDC Social Login (Applicant)
# Required in production. Exact public origin, no trailing path; used to build registered callback URLs.
APP_BASE_URL=https://careers.example.com
# Register https://careers.example.com/api/applicants/auth/{google,linkedin,facebook}/callback with each enabled provider.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Facebook: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Redis (for OAuth state store, production horizontal scaling)
# REDIS_URL=redis://localhost:6379
# Or for Redis with password: redis://:password@host:port

# ── Durable storage (NFR-034) ────────────────────────────────────────────────
# Set DATABASE_URL to use PostgreSQL (recommended; required in production). Add ?sslmode=require for hosted DBs.
# Unset => local JSON files under DATA_DIR (default ./data): dev/test only, single process, NOT durable.
# DATABASE_URL=postgres://user:password@localhost:5432/recruiting
# USE_DATABASE=true   # optional: "true" fails startup if DATABASE_URL is missing; "false" forces JSON even if DATABASE_URL is set
# DATABASE_SCHEMA=    # optional: isolate all tables in this Postgres schema (e.g. per test run)
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# NODE_ENV=production without DATABASE_URL refuses to start unless ALLOW_JSON_STORE=true (explicit ephemeral opt-in).
# Postgres configured but unreachable => startup fails and /ready reports not_ready; it NEVER falls back to JSON.
# Migrate legacy JSON: npm run db:migrate-json -- --dry-run   then   npm run db:migrate-json
