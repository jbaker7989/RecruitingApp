# LLM Provider API Keys (Required for Agentic Workflows)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override default port
PORT=3000

# Optional: Environment (development/production)
NODE_ENV=development

# OAuth 2.0 / OIDC Social Login (Applicant)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Facebook: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# PostgreSQL Database (production — required for DATABASE_URL to switch to DB mode)
# Local:  postgres://postgres:postgres@localhost:5432/recruiting_test
# Vercel Postgres: postgres://... (from vercel env vars)
# Neon:         postgres://user:pass@ep-xxx.neon.tech/recruiting?sslmode=require
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruiting_test

# Redis (for OAuth state store, production horizontal scaling)
# REDIS_URL=redis://localhost:6379

# ─── JWT Secrets (REQUIRED in production, story-commercial-auth-hardening) ──
# In production (NODE_ENV=production), the app fails to start if these are:
#   - unset
#   - set to the dev default values
#   - shorter than 32 characters
# Generate strong secrets with: openssl rand -base64 48
# USER (recruiter / hiring-manager / admin) tokens — 8h expiry
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
# APPLICANT tokens — 7d expiry
APPLICANT_JWT_SECRET=change-me-to-a-different-strong-random-secret-32+